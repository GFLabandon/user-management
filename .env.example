# MySQL profile: load these variables in your shell; Spring does not read this file automatically.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/campus_counselor?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=counselor_app
DB_PASSWORD=replace-me

# Existing demonstration login; database account authorization is a later phase.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-me
UPLOAD_DIR=./uploads
SERVER_PORT=8080
