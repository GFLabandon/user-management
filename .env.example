# Local MySQL configuration. For deployment use .env.deploy.example and scripts/run-deploy.sh.
# MySQL profile: load these variables in your shell; Spring does not read this file automatically.
SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/campus_counselor?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=counselor_app
DB_PASSWORD=replace-me

# Required only when a non-demo account database is empty. Use your own values.
# Password: 12-64 characters and at most 72 UTF-8 bytes; stored as a bcrypt hash.
# Remove bootstrap credentials after first start; existing accounts are never reset.
APP_BOOTSTRAP_USERNAME=your-admin-name
APP_BOOTSTRAP_PASSWORD=replace-with-a-unique-password
UPLOAD_DIR=./uploads
SERVER_PORT=8080
