# Copy to .env.deploy, chmod 600, and fill your own values. Never commit .env.deploy.
# scripts/run-deploy.sh fixes the profile to deploy; this file is not loaded automatically.
DB_URL=''
DB_USERNAME=''
DB_PASSWORD=''
# Existing absolute directory, writable by the Java process.
UPLOAD_DIR=''
# Only for the first Web startup of an empty account database; remove after success.
APP_BOOTSTRAP_USERNAME=''
APP_BOOTSTRAP_PASSWORD=''
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# false only for loopback HTTP verification; true for the future HTTPS entry point.
SESSION_COOKIE_SECURE=true
