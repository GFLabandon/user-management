# Copy to .env.compose, chmod 600, and fill with distinct random values.
# Compose reads this file only with --env-file .env.compose.
DB_PASSWORD=''
MYSQL_ROOT_PASSWORD=''
APP_BOOTSTRAP_USERNAME=''
APP_BOOTSTRAP_PASSWORD=''
APP_PORT=8080
# Remove the bootstrap username/password after the first successful startup.
# Keep DB_PASSWORD and MYSQL_ROOT_PASSWORD consistent with the existing volume.
